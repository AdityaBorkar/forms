{
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/bun": "^1.3.14",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "taze": "^19.14.1",
    "typescript": "^7.0.1-rc",
    "vite": "^8.1.4",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "analyze:packages": "bun audit",
    "check:lint": "bun biome check --fix .",
    "check:types": "bun tsc -b",
    "prepare": "husky",
    "update:deps": "bun taze -rw --maturity-period 3 && bun install"
  },
  "workspaces": ["./package", "./examples"]
}
