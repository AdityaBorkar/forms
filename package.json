{
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@changesets/cli": "^3.0.1",
		"@commitlint/cli": "^21.2.2",
		"@commitlint/config-conventional": "^21.2.2",
		"@types/bun": "^1.4.0",
		"husky": "^9.1.7",
		"jsdom": "^30.0.1",
		"taze": "^21.1.0",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.11"
	},
	"scripts": {
		"analyze:packages": "bun audit",
		"check:lint": "biome check --fix .",
		"check:types": "tsc -b",
		"format": "biome format --fix .",
		"prepare": "husky",
		"update:deps": "bun taze -rw --maturity-period 3 && bun install"
	},
	"workspaces": [
		"./package",
		"./examples"
	]
}
